        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Demo Biscuit\",\n  \"barcode\": \"{{$randomInt}}{{$timestamp}}\",\n  \"mrp\": \"10.00\",\n  \"purchase_rate\": \"7.50\",\n  \"selling_rate\": \"9.50\",\n  \"gst_rate\": \"18.00\"\n}"
        }
